#!/usr/bin/bash
set -euo pipefail

# A terminal entry point for security tools. Opening a menu item never starts
# a capture, scan, or password audit without an explicit user command.
case "${1:-}" in
    nmap) tool="nmap"; help="nmap --help" ;;
    arp-scan) tool="arp-scan"; help="arp-scan --help" ;;
    masscan) tool="masscan"; help="masscan --help" ;;
    traceroute) tool="traceroute"; help="traceroute --help" ;;
    whois) tool="whois"; help="whois --help" ;;
    tshark) tool="tshark"; help="tshark --help" ;;
    tcpdump) tool="tcpdump"; help="tcpdump --help" ;;
    ncat) tool="ncat"; help="ncat --help" ;;
    scapy) tool="scapy"; help="scapy" ;;
    socat) tool="socat"; help="socat -h" ;;
    ettercap) tool="ettercap"; help="ettercap --help" ;;
    nuclei) tool="nuclei"; help="nuclei -h" ;;
    gobuster) tool="gobuster"; help="gobuster --help" ;;
    whatweb) tool="whatweb"; help="whatweb --help" ;;
    aircrack-ng) tool="aircrack-ng"; help="aircrack-ng --help" ;;
    airodump-ng) tool="airodump-ng"; help="airodump-ng --help" ;;
    airmon-ng) tool="airmon-ng"; help="airmon-ng --help" ;;
    aireplay-ng) tool="aireplay-ng"; help="aireplay-ng --help" ;;
    kismet) tool="kismet"; help="kismet --help" ;;
    hcxpcapngtool) tool="hcxpcapngtool"; help="hcxpcapngtool --help" ;;
    hashcat) tool="hashcat"; help="hashcat --help" ;;
    john) tool="john"; help="john" ;;
    hydra) tool="hydra"; help="hydra -h" ;;
    medusa) tool="medusa"; help="medusa -h" ;;
    fls) tool="fls"; help="fls -h" ;;
    foremost) tool="foremost"; help="foremost -h" ;;
    testdisk) tool="testdisk"; help="testdisk" ;;
    binwalk) tool="binwalk"; help="binwalk --help" ;;
    r2) tool="r2"; help="r2 -h" ;;
    gdb) tool="gdb"; help="gdb --help" ;;
    strace) tool="strace"; help="strace --help" ;;
    lynis) tool="lynis"; help="lynis show help" ;;
    chkrootkit) tool="chkrootkit"; help="chkrootkit -h" ;;
    rkhunter) tool="rkhunter"; help="rkhunter --help" ;;
    *)
        printf 'Unknown YotaOS security tool: %s\n' "${1:-<none>}" >&2
        exit 2
        ;;
esac

printf '\nYotaOS Security: %s\n' "$tool"
printf '%s\n' '-------------------------------'
if command -v "$tool" >/dev/null 2>&1; then
    printf 'Installed: %s\n' "$(command -v "$tool")"
    printf 'Opening: %s\n\n' "$help"
    # The arguments come from the fixed allowlist above, not user input.
    read -r -a usage_command <<< "$help"
    "${usage_command[@]}" || true
else
    printf 'Not installed in this environment: %s\n' "$tool"
    printf 'Once installed, run: %s\n' "$help"
fi
printf '\nYou can continue working in this terminal.\n'
printf 'Only assess systems and networks you are authorized to test.\n\n'
exec "${SHELL:-/bin/bash}" -i
