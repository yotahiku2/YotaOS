Window.SetBackgroundTopColor(0.008, 0.008, 0.015);
Window.SetBackgroundBottomColor(0.015, 0.010, 0.025);

logo.image = Image("yotaos.png");
logo.sprite = Sprite(logo.image);

logo.sprite.SetX(
    Window.GetWidth() / 2 -
    logo.image.GetWidth() / 2
);

logo.sprite.SetY(
    Window.GetHeight() / 2 -
    logo.image.GetHeight() / 2
);

fun refresh_callback ()
{
    logo.sprite.SetOpacity(0.82 + Math.Sin(Plymouth.GetTime() * 2.0) * 0.18);
}

Plymouth.SetRefreshFunction(refresh_callback);
